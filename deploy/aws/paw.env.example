# /etc/paw/paw.env（root:paw・パーミッション 0640）にコピーして値を埋める
# この中の値は秘密情報です。Git にコミットしないでください。

# 公開 URL（HTTPS）。Cookie の Secure 属性と、画面からの更新リクエストの Origin 確認に使う
PAW_PUBLIC_URL=https://paw.example.com
# 新規登録は最初の 1 人（あなた）だけ
PAW_SIGNUP=first_user
# デモデータ・GitHub シミュレーターは使わない
PAW_SEED_DEMO=0
PAW_DEV_ROUTES=0
# データの保存先（DB・成果物・作業コピー）
PAW_DATA_DIR=/var/lib/paw
# ログインセッションの署名鍵（openssl rand -hex 32 で作る）
PAW_SESSION_SECRET=

# --- Claude（サブスク） ---
PAW_AGENT_RUNTIME=claude-code
# 手元の PC で `claude setup-token` を実行して表示されたトークン（1 年有効）
CLAUDE_CODE_OAUTH_TOKEN=
# Claude の 1 工程あたりのタイムアウト（ミリ秒）
PAW_CLAUDE_STEP_TIMEOUT_MS=1800000
# 制限モード（--restricted）。手元の PC では 0 で動作を確認済み。サーバーで --restricted 付きの確認が通れば 1 にできる（手順 7）
PAW_CLAUDE_CODE_RESTRICTED=0

# --- GitHub App ---
PAW_GITHUB_APP_ID=
PAW_GITHUB_APP_PRIVATE_KEY_FILE=/etc/paw/github-app.pem
# GitHub App の設定画面で決めた Webhook secret と同じ値（openssl rand -hex 32 で作る）
PAW_GITHUB_WEBHOOK_SECRET=
# Issue からの起動・PR レビューを受け付ける GitHub ユーザー名（カンマ区切り）
PAW_GITHUB_ALLOWED_USERS=your-github-login
