# /etc/paw/paw.env（root:paw・パーミッション 0640）にコピーして値を埋める
# この中の値は秘密情報です。Git にコミットしないでください。

# 公開 URL（tailnet 内の HTTPS。tailscale serve が受ける）。Cookie の Secure 属性と、画面からの更新リクエストの Origin 確認に使う
PAW_PUBLIC_URL=https://paw.example.com
# 新規登録は最初の 1 人（あなた）だけ
PAW_SIGNUP=first_user
# 新規登録に必要なコード（openssl rand -hex 16 で作る）。公開 URL を他人に先に見つけられても登録されないようにする
PAW_SIGNUP_CODE=
# デモデータ・GitHub シミュレーターは使わない
PAW_SEED_DEMO=0
PAW_DEV_ROUTES=0
# データの保存先（DB・成果物・作業コピー）
PAW_DATA_DIR=/var/lib/paw
# ログインセッションの署名鍵（openssl rand -hex 32 で作る）
PAW_SESSION_SECRET=

# --- Claude（サブスク） ---
PAW_AGENT_RUNTIME=claude-code
# 手元の PC で `claude setup-token` を実行して表示されたトークン（1 年有効）
CLAUDE_CODE_OAUTH_TOKEN=
# Claude の 1 工程あたりのタイムアウト（ミリ秒）
PAW_CLAUDE_STEP_TIMEOUT_MS=1800000
# 制限モード（--restricted）。サーバーモードでは 1 が必須（0 や非対応の CLI では起動を拒む）
PAW_CLAUDE_CODE_RESTRICTED=1

# --- GitHub App ---
PAW_GITHUB_APP_ID=
PAW_GITHUB_APP_PRIVATE_KEY_FILE=/etc/paw/github-app.pem
# Issue からの起動・PR レビューを受け付ける GitHub ユーザー名（カンマ区切り）
PAW_GITHUB_ALLOWED_USERS=your-github-login
# 「自分担当」の Issue を判定する GitHub ログイン名（未設定なら PAW_GITHUB_ALLOWED_USERS の先頭）
PAW_GITHUB_LOGIN=your-github-login
# GitHub を見に行く間隔（ミリ秒。10000 以上）。Webhook は受けず、サーバーが定期的に取りに行く
PAW_GITHUB_POLL_MS=60000
# （開発用）署名付き Webhook の受け口を開くときだけ PAW_GITHUB_WEBHOOK=1 と PAW_GITHUB_WEBHOOK_SECRET（16 文字以上）を足す。
# 本番では足さない（インターネットから届く口を作らない）

# --- Tester（テストコマンド）の実行 ---
# サーバーモードでは docker が必須（host は起動を拒む）。作業コピーだけをマウントしたコンテナで動かす
PAW_TEST_SANDBOX=docker
PAW_TEST_IMAGE=node:22-bookworm
# deploy/aws/paw-test-network.sh が作る、ホストと内部ネットワークに届かない専用ネットワーク
PAW_TEST_NETWORK=paw-test
