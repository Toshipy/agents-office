# terraform.tfvars にコピーして値を入れる（このファイルに秘密情報は書かない）
github_app_id        = "1234567"
github_allowed_users = "Toshipy"
# 社内 VPN の出口 IP（ALB の 443 番を開ける送信元。必須）
allowed_cidrs = ["203.0.113.1/32"]

